[sub_resource type="Shader" id="EnemyCueShader"]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\nuniform vec4 base_color : source_color = vec4(1.0);\nvarying vec4 cue_data;\nvoid vertex() { cue_data = INSTANCE_CUSTOM; }\nvoid fragment() {\n float entry = clamp(cue_data.r, 0.0, 1.0);\n float hit = clamp(cue_data.g, 0.0, 1.0);\n float reduce_flashes = step(0.5, cue_data.a);\n float entry_emission = (1.0 - entry) * mix(1.5, 0.35, reduce_flashes);\n float hit_emission = hit * mix(1.45, 0.32, reduce_flashes);\n float white_mix = hit * mix(0.5, 0.25, reduce_flashes);\n ALBEDO = mix(base_color.rgb, vec3(1.0), white_mix);\n EMISSION = base_color.rgb * (0.22 + entry_emission) + vec3(1.0, 0.82, 0.55) * hit_emission;\n ROUGHNESS = 0.45;\n}\n"

